# 公開URL（canonical・OGP・sitemap.xml・robots.txt に使います。末尾スラッシュなし）
# NEXT_PUBLIC_SITE_URL="https://example.com"
#
# Google Search Console の所有権確認コード（任意）
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
#
# アフィリエイト計測URL（クリック用の https URL のみ。秘密鍵は置かない）
# コピーして `.env.local` に保存し、開発サーバーを再起動してください。
#
# 楽天はソースに A8 の既定URLがあります。上書きする場合のみ設定してください。
# 検索キーワード・金額は毎回、ポータルの検索結果URLとしてエンコードされます。
# 楽天A8は a8ejpredirect 内の hb.afl.rakuten.co.jp の pc / m を差し替えます。
#
# NEXT_PUBLIC_AFFILIATE_RAKUTEN="https://rpx.a8.net/svt/ejp?a8mat=XXXX&rakuten=y&a8ejpredirect=..."
# NEXT_PUBLIC_AFFILIATE_SATOFULL="https://px.a8.net/svt/ejp?a8mat=YYYYYY"
#
# 使えるプレースホルダ:
#   {url}     検索結果ページのURL（エンコード済み）
#   {query}   検索語（例: 牛肉 15000円）
#   {amount}  金額
#   {min} {max}  金額の検索レンジ

NEXT_PUBLIC_AFFILIATE_RAKUTEN=
NEXT_PUBLIC_AFFILIATE_SATOFULL=
NEXT_PUBLIC_AFFILIATE_CHOICE=
NEXT_PUBLIC_AFFILIATE_FURANAVI=
